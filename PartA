    string infix;
    getline(cin, infix);
 
    string prefix = infixToPrefix(tokenize(infix));
    cout << "Prefix: " << prefix << "\n";
 
    Node* root = prefixToTreeRec(prefix);
    Node* root = prefixToTreeIter(prefix);
 
    cout << "In-order (rec):    "; inorderRec(root) << "\n";
    cout << "In-order (iter):   "; inorderIter(root) << "\n";
    cout << "Pre-order (rec):   "; preorderRec(root) << "\n";
    cout << "Pre-order (iter):  "; preorderIter(root) << "\n";
    cout << "Post-order (rec):  "; postorderRec(root) << "\n";
    cout << "Post-order (iter): "; postorderIter(root) << "\n";
    return 0;
}
 